# DOGE baseline weekly walk-forward regime research.
# The systemd timer schedule remains in pm-bot-doge-regime-research.timer.
DOGE_BASELINE_REGIME_FRAME=5m
DOGE_BASELINE_REGIME_COUNT=25
DOGE_BASELINE_REGIME_TRAIN_COUNT=500
DOGE_BASELINE_REGIME_REPLAY_COUNT=100
DOGE_BASELINE_REGIME_LATENCY_MS=250

# Wait for the first successful continuous refresh before restarting strategy.
DOGE_BASELINE_REGIME_REFRESH_WAIT_TIMEOUT_SECONDS=7200
DOGE_BASELINE_REGIME_REFRESH_POLL_INTERVAL_SECONDS=5
