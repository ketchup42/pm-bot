{
  "name": "pm-bot",
  "version": "1.1.0",
  "description": "Polymarket trading little bot:)",
  "main": "dist/app/index.js",
  "scripts": {
    "start": "node ./dist/app/index.js",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:history": "npm run build && node --test test/*.test.mjs",
    "dev": "node --experimental-strip-types src/app/index.ts",
    "collect": "npm run build && node dist/app/collect.js",
    "history:settle": "npm run build && node dist/app/settle-history.js",
    "backtest": "npm run build && node dist/app/backtest.js",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "devDependencies": {
    "@types/lodash": "^4.17.17",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@polymarket/client": "^0.8.1",
    "@polymarket/clob-client-v2": "1.0.6",
    "@polymarket/real-time-data-client": "^1.4.0",
    "dotenv": "^17.4.2",
    "lodash": "^4.17.21",
    "ms": "^2.1.3",
    "polymarket-websocket-client": "^0.1.1",
    "uuid": "^14.0.0",
    "viem": "^2.48.11",
    "winston": "^3.19.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "ws": "^8.21.3"
  }
}
