# DOGE Baseline command parameters used by Docker Compose.
DOGE_BASELINE_COLLECT_COIN=doge
DOGE_BASELINE_COLLECT_FRAME=5m
DOGE_BASELINE_COLLECT_SOURCE=chainlink-twap-60
DOGE_BASELINE_COLLECT_COUNT=700

# Allowed values: debug, live.
DOGE_BASELINE_STRATEGY_MODE=debug
DOGE_BASELINE_BALANCE=100
DOGE_BASELINE_TRADE_VALUE=10

DOGE_BASELINE_REFRESH_FRAME=5m
DOGE_BASELINE_REFRESH_COUNT=50
DOGE_BASELINE_REFRESH_TRAIN_COUNT=500
DOGE_BASELINE_REFRESH_REPLAY_COUNT=100
DOGE_BASELINE_REFRESH_LATENCY_MS=250
